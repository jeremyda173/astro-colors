---

<div class="palette-grid">
  {colorPalettes.map((palette, paletteIndex) => (
    <div 
      class="palette-card glass-card fade-in-up" 
      style={`animation-delay: ${paletteIndex * 0.05}s`}
    >
      <h3 class="palette-name">{palette.name}</h3>
      <div class="color-swatches">
        {palette.colors.map((color) => (
          <div class="color-swatch-wrapper">
            <div 
              class="color-swatch" 
              style={`background-color: ${color}`}
              data-color={color}
            >
            </div>
            <div class="color-code mono">{color}</div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .palette-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-xl);
    padding: var(--spacing-2xl) 0;
  }

  .palette-card {
    padding: var(--spacing-lg);
    opacity: 0;
  }

  .palette-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
    letter-spacing: -0.01em;
  }

  .color-swatches {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .color-swatch-wrapper {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .color-swatch-wrapper:hover {
    background: var(--color-glass-bg);
    transform: translateX(4px);
  }

  .color-swatch {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .color-swatch::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, transparent 100%);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .color-swatch-wrapper:hover .color-swatch {
    transform: scale(1.1);
    box-shadow: var(--shadow-lg);
  }

  .color-swatch-wrapper:hover .color-swatch::after {
    opacity: 1;
  }

  .color-code {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    user-select: all;
    transition: color var(--transition-fast);
  }

  .color-swatch-wrapper:hover .color-code {
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .palette-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .color-swatch {
      width: 50px;
      height: 50px;
    }
  }
</style>
