---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ColorPalettes from '../components/ColorPalettes.astro';
import CopyHandler from '../components/CopyHandler.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Hero />
	
	<section class="palettes-section">
		<div class="container">
			<!-- Static HTML rendering - Zero JavaScript -->
			<ColorPalettes />
		</div>
	</section>
	
	<!-- Interactive component - Logic is inside the script tag -->
	<CopyHandler />
	
	<Footer />
</Layout>

<style>
	.palettes-section {
		padding: var(--spacing-xl) 0;
	}
</style>
